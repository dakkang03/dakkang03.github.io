---
import { siteConfig } from "../config";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const hasExperiences =
  (siteConfig.experience && siteConfig.experience.length > 0) ||
  ((siteConfig.teaching?.length ?? 0) > 0);
const hasPublications = siteConfig.publication && siteConfig.publication.length > 0;
const hasAwards = (siteConfig.awards?.length ?? 0) > 0;

const tabs = [
  { id: "home", label: "Home", show: true },
  { id: "projects", label: "Projects", show: hasProjects },
  { id: "experiences", label: "Experiences", show: hasExperiences },
  { id: "publications", label: "Publications", show: hasPublications },
  { id: "awards", label: "Awards", show: hasAwards },
].filter((tab) => tab.show);
---

<nav
  class="border-b border-gray-100 px-6 sm:px-10 md:px-12 pt-6 sm:pt-8 pb-4"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <ul class="flex flex-wrap items-center gap-5 sm:gap-8">
    {
      tabs.map((tab) => (
        <li>
          <button
            type="button"
            class="tab-link text-sm sm:text-base text-gray-600 hover:text-gray-900 transition-colors duration-200 font-medium"
            data-tab={tab.id}
          >
            {tab.label}
          </button>
        </li>
      ))
    }
  </ul>
</nav>

<script define:vars={{ accentColor: siteConfig.accentColor }}>
  const tabLinks = document.querySelectorAll(".tab-link");
  const panels = document.querySelectorAll("[data-panel]");

  function activateTab(tabId) {
    panels.forEach((panel) => {
      panel.hidden = panel.id !== `panel-${tabId}`;
    });
    tabLinks.forEach((link) => {
      const isActive = link.getAttribute("data-tab") === tabId;
      link.style.color = isActive ? accentColor : "";
      link.classList.toggle("font-semibold", isActive);
    });
  }

  tabLinks.forEach((link) => {
    link.addEventListener("click", () => {
      activateTab(link.getAttribute("data-tab"));
    });
  });

  if (tabLinks.length > 0) {
    activateTab(tabLinks[0].getAttribute("data-tab"));
  }
</script>
