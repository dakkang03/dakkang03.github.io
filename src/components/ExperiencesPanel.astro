---
import { siteConfig } from "../config";

const hasWork = siteConfig.experience && siteConfig.experience.length > 0;
const hasTeaching = (siteConfig.teaching?.length ?? 0) > 0;
---

<div class="space-y-12">
  <section>
    <h2 class="text-3xl sm:text-4xl font-bold" style={{ color: siteConfig.accentColor }}>
      Work Experiences
    </h2>
    {
      hasWork ? (
        <div class="divide-y divide-gray-200 mt-6">
          {siteConfig.experience.map((exp) => (
            <div class="py-6">
              <h3 class="font-semibold text-gray-900">{exp.title}</h3>
              <p class="text-gray-600">{exp.company}</p>
              <p class="text-sm text-gray-500 mt-1">{exp.dateRange}</p>
              {exp.bullets && exp.bullets.length > 0 && (
                <ul class="mt-3 space-y-1.5">
                  {exp.bullets.map((bullet) => (
                    <li class="flex items-start text-sm text-gray-600">
                      <span class="inline-block w-1.5 h-1.5 rounded-full bg-gray-400 mt-1.5 mr-2 flex-shrink-0" />
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))}
        </div>
      ) : (
        <p class="text-gray-400 text-sm mt-6">Work experience coming soon.</p>
      )
    }
  </section>

  <section>
    <h2 class="text-3xl sm:text-4xl font-bold" style={{ color: siteConfig.accentColor }}>
      Teaching Experiences
    </h2>
    {
      hasTeaching ? (
        <div class="divide-y divide-gray-200 mt-6">
          {siteConfig.teaching!.map((t) => (
            <div class="py-4 flex items-center justify-between">
              <span class="text-gray-900 font-medium">{t.title}</span>
            </div>
          ))}
        </div>
      ) : (
        <p class="text-gray-400 text-sm mt-6">Teaching experience coming soon.</p>
      )
    }
  </section>
</div>
